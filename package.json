{
  "name": "@lateraltranslucence/cera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cera: a panel-based CMS for Next.js and Supabase, successor to the Developers Only WordPress theme",
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next/index.ts",
    "./supabase": "./src/supabase/index.ts",
    "./admin": "./src/admin/index.ts",
    "./admin.css": "./src/admin/admin.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
