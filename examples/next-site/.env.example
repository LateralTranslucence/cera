# Copy to .env.local, or generate it from a running local stack with `npm run env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Required to enter draft-mode preview: /api/cera/draft?secret=…&slug=about
CERA_PREVIEW_SECRET=
# Daily cleanup (/api/cera/cleanup, see vercel.json): Vercel Cron sends it as a bearer token.
CRON_SECRET=
# Form and approval emails (lib/email.ts): an SMTP server, and who the emails come from. Locally, `npm run env` points
# SMTP_URL at the Supabase stack's test inbox. Unset: form emails are logged and skipped.
SMTP_URL=
CERA_EMAIL_FROM=
# The site's public address, for links in approval emails. Default: the production domain on Vercel, else http://localhost:3100.
CERA_SITE_URL=
