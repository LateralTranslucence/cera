{
  // Emits the package: JavaScript and type definitions in dist/, mirroring src/.
  // Relative imports are written with .ts/.tsx and rewritten to .js on emit.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
