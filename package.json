{
  "name": "@lateraltranslucence/cera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cera: a panel-based CMS for Next.js and Supabase, successor to the Developers Only WordPress theme",
  "files": [
    "dist",
    "supabase/migrations",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/cache": {
      "source": "./src/next/cache.ts",
      "types": "./dist/next/cache.d.ts",
      "default": "./dist/next/cache.js"
    },
    "./panels": {
      "source": "./src/panels/index.ts",
      "types": "./dist/panels/index.d.ts",
      "default": "./dist/panels/index.js"
    },
    "./forms": {
      "source": "./src/forms/index.ts",
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./icons": {
      "source": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./menus": {
      "source": "./src/menus/index.ts",
      "types": "./dist/menus/index.d.ts",
      "default": "./dist/menus/index.js"
    },
    "./supabase": {
      "source": "./src/supabase/index.ts",
      "types": "./dist/supabase/index.d.ts",
      "default": "./dist/supabase/index.js"
    },
    "./admin": {
      "source": "./src/admin/index.ts",
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin.css": "./dist/admin/admin.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=source --import tsx --test test/*.test.ts test/*.test.tsx",
    "check": "npm run typecheck && npm test",
    "build:watch": "node scripts/build.mjs --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tiptap/core": "3.32.3",
    "@tiptap/extension-image": "3.32.3",
    "@tiptap/extension-subscript": "3.32.3",
    "@tiptap/extension-superscript": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "lucide-static": "1.70.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@supabase/ssr": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "happy-dom": "21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "examples/next-site"
  ]
}
