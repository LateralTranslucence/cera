# Copy to .env.local, or generate it from a running local stack with `npm run env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Required to enter draft-mode preview: /api/draft?secret=…&slug=about
CERA_PREVIEW_SECRET=
# Daily cleanup (/api/cera/cleanup, see vercel.json): Vercel Cron sends it as a bearer token.
CRON_SECRET=
